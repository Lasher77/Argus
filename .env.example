# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env-Datei selbst gehört NICHT ins Git (siehe .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=auftragsbuch
POSTGRES_PASSWORD=bitte-starkes-passwort-eintragen
POSTGRES_DB=auftragsbuch

# --- Backend ---
PORT=3000
# Verbindungs-URL zur Datenbank (Host "db" = der Postgres-Dienst in docker-compose).
DATABASE_URL=postgres://auftragsbuch:bitte-starkes-passwort-eintragen@db:5432/auftragsbuch
# Geheimnis für Session-Cookies – langen, zufälligen Wert eintragen.
SESSION_SECRET=bitte-langen-zufallswert-eintragen
# Session-Cookie nur über HTTPS senden. Lokal (http://localhost) auf "false"
# lassen, im Produktivbetrieb hinter Caddy/HTTPS auf "true" setzen.
SESSION_COOKIE_SECURE=false

# --- Domain / HTTPS ---
# Lokaler Betrieb: "http://localhost" (Default in Caddy; keine TLS-Zertifikate).
# Produktionsbetrieb: die echte Domain eintragen, dann holt Caddy automatisch
# ein Let's-Encrypt-Zertifikat und erneuert es. Voraussetzung: die Domain zeigt
# per DNS auf den Server und die Ports 80/443 sind aus dem Internet erreichbar.
APP_DOMAIN=http://localhost
# Optional: für Let's-Encrypt-Benachrichtigungen einen globalen Block im
# Caddyfile ergänzen:
#   {
#     email du@beispiel.de
#   }

# --- Backups ---
# Aufbewahrungszeit (Tage) und Intervall (Sekunden) für PostgreSQL-Dumps.
# Backups landen im Ordner ./backups (gitignored).
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
