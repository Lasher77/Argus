# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env-Datei selbst gehört NICHT ins Git (siehe .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=auftragsbuch
POSTGRES_PASSWORD=bitte-starkes-passwort-eintragen
POSTGRES_DB=auftragsbuch

# --- Backend ---
PORT=3000
# Verbindungs-URL zur Datenbank (Host "db" = der Postgres-Dienst in docker-compose).
DATABASE_URL=postgres://auftragsbuch:bitte-starkes-passwort-eintragen@db:5432/auftragsbuch
# Geheimnis für Session-Cookies – langen, zufälligen Wert eintragen.
SESSION_SECRET=bitte-langen-zufallswert-eintragen

# --- Domain / HTTPS (Produktion) ---
# Lokal bleibt die App über http://localhost erreichbar.
# Für den Server: diese Domain im Caddyfile aktivieren.
APP_DOMAIN=argus.wits-berlin.org
